generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Define the lifespan of the asset
enum AssetType {
  DURABLE
  CONSUMABLE
}

// The broad physical category (e.g., "Hardware", "Athletics")
model Category {
  id    String @id @default(uuid())
  name  String @unique
  items Item[]
}

// The activity group (e.g., "Night Games", "Team Building")
model Kit {
  id    String @id @default(uuid())
  name  String @unique
  items Item[]
}

// The actual physical object in the storage room
model Item {
  id         String    @id @default(uuid())
  name       String
  quantity   Int       @default(1)
  location   String?   
  assetType  String?   
  
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  
  kits       Kit[]     // <-- Fixed line
  
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}